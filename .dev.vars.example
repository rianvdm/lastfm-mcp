# Local development secrets. Copy to .dev.vars and fill in real values:
#
#   cp .dev.vars.example .dev.vars
#
# The Last.fm values come from your Last.fm API account: https://www.last.fm/api/account/create
# CONSENT_SECRET signs the remembered-consent cookie: any random string of 32+ characters
# (e.g. `openssl rand -base64 32`).
# Production uses the same three names via `wrangler secret put ... --env production`
# (or `npm run setup:prod`). No other secrets are required.

LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
CONSENT_SECRET=
